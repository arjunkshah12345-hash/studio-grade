# Whitelist: only the skill, the website source and what it builds from.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LAUNCH.md
!/.github/
!/studio-grade/

!/web/
/web/dist/
.vercel

!/tools/
/tools/*
!/tools/web/
!/tools/package.json
!/tools/package-lock.json

!/tests/
/tests/*
!/tests/feedback/
!/tests/builds/
/tests/builds/*
!/tests/builds/nocturne/
!/tests/builds/sprout/
!/tests/builds/tally/
!/tests/builds/fieldwork/
!/tests/builds/relay/
!/tests/builds/halden2/
!/tests/builds/kestrel2/
!/tests/builds/onair/
!/tests/builds/lantern/
!/tests/builds/morrow/
!/tests/builds/darksky/
!/tests/builds/tidewell/
!/tests/builds/hush/
!/tests/builds/nightlight/
!/tests/builds/switchback/
!/tests/builds/haul/

# research: our notes only, never third-party screenshots or scraped pages
!/research/
/research/*
!/research/AGGREGATE.md
!/research/*/
/research/*/*
!/research/*/NOTES.md

**/audit*/
**/_audit/
**/node_modules/
.DS_Store
